<launch>
  <!-- Path to the video file to analyse. Override with:
       roslaunch child_safety_monitoring video_file_demo.launch video_file:=/path/to/video.mp4 -->
  <arg name="video_file" default="/root/data/videos/test_1.mp4" />
  <arg name="pose_model"  default="yolo11n-pose.pt" />
  <!-- Set loop:=true to replay the video continuously -->
  <arg name="loop"        default="false" />

  <!-- Stream from video file instead of live camera -->
  <node pkg="child_safety_monitoring" type="cctv_stream_node.py" name="cctv_stream_node" output="screen">
    <param name="stream_url"       value="$(arg video_file)" />
    <param name="image_topic"      value="/camera/image_raw" />
    <param name="camera_frame_id"  value="video_camera" />
    <param name="publish_rate_hz"  value="15.0" />
    <param name="loop"             value="$(arg loop)" />
  </node>

  <!-- Full detection pipeline (reuses robot camera launch) -->
  <include file="$(find child_safety_monitoring)/launch/jupiter_robot_camera_demo.launch">
    <arg name="camera_topic" value="/camera/image_raw" />
    <arg name="pose_model"   value="$(arg pose_model)" />
  </include>
</launch>
